#!/usr/bin/env bash
#
# Build and read the Xivi documentation.
#
#   bin/docs serve     serve on http://localhost:8081, rebuilding as you edit
#   bin/docs build     build once into site/ — this is the one CI should run
#   bin/docs shell     a shell in the container, for when something is wrong
#
# **Everything runs in a container**, because nothing is installed on the host —
# the same rule `bin/compose` enforces in the main repository. The image is
# `squidfunk/mkdocs-material`, published by the theme's own maintainers, so there
# is no toolchain here to keep up to date beyond a tag.
#
# `build` is strict: a link to a page that does not exist fails it. That is set
# in `mkdocs.yml` rather than here, so an editor running mkdocs directly gets the
# same answer as CI.

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

# The container writes `site/` into the working tree, so it runs as whoever is
# reading it. Without this the output comes back owned by root and the next
# build cannot delete it.
DOCS_UID="$(id -u)"
DOCS_GID="$(id -g)"
export DOCS_UID DOCS_GID

case "${1:-serve}" in
	serve)
		printf 'Reading at http://localhost:%s — Ctrl-C to stop.\n\n' "${DOCS_PORT:-8081}"
		# `--dev-addr` on 0.0.0.0 because the port is published from inside the
		# container; the image's default binds the loopback it cannot be reached on.
		docker compose run --rm --service-ports docs serve --dev-addr=0.0.0.0:8000
		;;
	build)
		docker compose run --rm docs build --strict
		;;
	shell)
		docker compose run --rm --entrypoint sh docs
		;;
	-h|--help)
		sed -n '3,7p' "${BASH_SOURCE[0]}" | cut -c 3-
		;;
	*)
		printf 'Unknown command: %s\n\n' "$1" >&2
		sed -n '3,7p' "${BASH_SOURCE[0]}" | cut -c 3- >&2
		exit 64
		;;
esac
